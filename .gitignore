# PyCharm 本地配置
.idea/
*.iml

# Python 字节码和缓存
__pycache__/
*.py[cod]
*$py.class

# 虚拟环境（位于项目根目录）
/.venv/
/venv/
/env/
/ENV/
.Python

# 打包和构建产物
/build/
/dist/
/.eggs/
*.egg-info/
*.egg

# 测试、覆盖率和代码检查缓存
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
/htmlcov/
/coverage.xml
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# Jupyter Notebook 自动保存
.ipynb_checkpoints/

# 本地环境变量；保留可提交的配置示例
.env
.env.*
!.env.example
!.env.sample
!.env.template

# 运行日志
*.log
/logs/

# 操作系统生成的文件
.DS_Store
Thumbs.db
Desktop.ini

# 依赖声明和锁文件应按项目需要提交，故不忽略：
# requirements*.txt、pyproject.toml、Pipfile、Pipfile.lock、
# poetry.lock、uv.lock、pdm.lock
